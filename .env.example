# Copy to .env for local runs. On GitHub Actions, set these as repository secrets instead.
# NEVER commit a real .env file.

# Channel to watch: the UC... channel ID is the most reliable (a @handle or URL also works
# when YOUTUBE_API_KEY is set).
YT_CHANNEL=UCxxxxxxxxxxxxxxxxxxxxxx

# Recommended. Free key from Google Cloud Console (enable "YouTube Data API v3").
# Reads public data only; it is not a login. Without it the bot falls back to YouTube's RSS
# feed, which is unreliable.
YOUTUBE_API_KEY=

ANTHROPIC_API_KEY=

# Outputs -----------------------------------------------------------------------------------
# Fill in at least one. Every fully configured output is used automatically. To restrict it,
# list them: OUTPUTS=discord,slack   (choices: discord, slack, telegram, email)
OUTPUTS=

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Treat webhook URLs as secrets: anyone who has one can post to your channel.
DISCORD_WEBHOOK_URL=

# Slack: https://api.slack.com/apps > Incoming Webhooks > Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# Telegram: create a bot with @BotFather, message it once, then find your chat ID
# (https://api.telegram.org/bot<TOKEN>/getUpdates, look for "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (any SMTP server; for Gmail use an app password). Port 587 = STARTTLS, 465 = SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional ---------------------------------------------------------------------------------
# Model used for summaries (default: claude-sonnet-5-5; claude-haiku-5-5 is cheaper).
ANTHROPIC_MODEL=

# Who the summary is written for. This decides what counts as "Important". Example:
# USER_CONTEXT=an active swing trader who wants price levels, dates and explicit calls
USER_CONTEXT=

# Proxy for caption downloads if YouTube blocks GitHub's servers, e.g. http://user:pass@host:port
TRANSCRIPT_PROXY_URL=

MAX_VIDEOS_PER_RUN=3
MIN_DURATION_SEC=600
MAX_TRANSCRIPT_ATTEMPTS=4
STATE_FILE=state/seen_videos.json
